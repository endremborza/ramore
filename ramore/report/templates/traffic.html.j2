{% extends "_base.html.j2" %}
{% set depth = 0 %}
{% block title %}Traffic{% endblock %}
{% block content %}
<h1>Traffic</h1>

<section>
<h2>Bot vs human over time</h2>
{{ bot_area_chart | safe }}
</section>

<section>
<h2>Top user agents (sessions)</h2>
{{ top_uas_table | safe }}
</section>

<section>
<h2>Top referrer domains</h2>
{{ top_refs_table | safe }}
</section>

<section>
<h2>Top entry routes (human-likely sessions)</h2>
{{ top_paths_table | safe }}
</section>

<section>
<h2>Status code distribution</h2>
{{ status_chart | safe }}
</section>

<script>
document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll("table.dt").forEach(t => new DataTable(t, {pageLength: 20}));
});
</script>
{% endblock %}
