{% extends "_base.html.j2" %}
{% from "_kpi_card.html.j2" import kpi_grid %}
{% set depth = 0 %}
{% block title %}{{ site_name }} — landing{% endblock %}
{% block content %}
<h1>Overview</h1>

{% for label, k in windows.items() %}
<section class="kpi-section">
<h2>{{ label }}</h2>
{{ kpi_grid(k) }}
</section>
{% endfor %}

<section>
<h2>Requests over the last 30 days</h2>
{{ traffic_chart | safe }}
</section>

{% if login_chart %}
<section>
<h2>{{ login_label }} per day</h2>
{{ login_chart | safe }}
</section>
{% endif %}

<section>
<h2>Bot vs human (sessions)</h2>
{{ bot_chart | safe }}
</section>
{% endblock %}
